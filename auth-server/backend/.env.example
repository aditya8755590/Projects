# =========================================================
#  .env.example
#  Copy this file to .env  →  cp .env.example .env
#  The .env file is in .gitignore, so your real secrets
#  are NEVER committed to the repository.
# =========================================================

# Port the Express server listens on (frontend uses 5173).
PORT=4000

# MongoDB connection string.
#   mongodb://127.0.0.1:27017/auth_learning
# 127.0.0.1 (a real TCP socket) is safer than "localhost" on some
# Node versions where "localhost" can resolve to IPv6 (::1) while
# MongoDB listens only on IPv4.
MONGO_URI=mongodb://127.0.0.1:27017/auth_learning

# The frontend origin. CORS will ONLY accept requests from here,
# and it must be the exact origin (scheme + host + port).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLIENT_URL=http://localhost:5173

# =========================================================
#  JWT SECRETS — MUST BE TWO DIFFERENT, LONG, RANDOM STRINGS
#  We never log or expose these. If an attacker learns the
#  access secret they can forge tokens; if they learn the
#  refresh secret they can mint valid sessions for life.
# =========================================================
JWT_ACCESS_SECRET=change_me__use_a_long_random_access_secret_please
JWT_REFRESH_SECRET=change_me__use_a_different_long_random_refresh_secret

# Token lifetimes.
# Access  token: short lived (15 minutes)  -> limits damage if stolen.
# Refresh token: long lived  (7 days)      -> makes the session survive.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =========================================================
#  Cookies
#  COOKIE_SECURE=true when the site runs over HTTPS
#  (production). Locally we run over plain HTTP, so it must
#  be false, otherwise the browser will REJECT the cookies.
# =========================================================
COOKIE_SECURE=false